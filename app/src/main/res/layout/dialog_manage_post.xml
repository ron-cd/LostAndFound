<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/IV_photo"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginStart="50dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginEnd="50dp"
            android:scaleType="centerCrop"
            android:src="@drawable/add_photo_icon"

            app:shapeAppearanceOverlay="@style/roundedCorners"/>


        <EditText
            android:id="@+id/TV_Description"
            android:gravity="start"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:textSize="14sp"
            android:focusable="false"
            android:editable="false"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="25dp"
            android:inputType="textMultiLine"
            android:fontFamily="@font/konkhmer"
            android:elevation="4dp"
            android:maxLines="10"
            android:background="@drawable/rounded_border"
            android:hint="Please write a brief explanation..."/>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <Button
                android:id="@+id/BTN_Claim"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="#82ED82"
                android:fontFamily="@font/konkhmer"
                android:text="Mark As Found"
                android:textColor="@color/green"
                android:textStyle="bold" />

            <Space
                android:layout_width="20dp"
                android:layout_height="match_parent"/>

            <Button
                android:id="@+id/BTN_Returned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:backgroundTint="#82ED82"
                android:fontFamily="@font/konkhmer"
                android:text="Mark As Returned"
                android:textColor="@color/green"
                android:textStyle="bold" />



        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>